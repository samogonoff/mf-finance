[{
    "pattern": "GET /api/auth/me",
    "handler": "auth.Me",
    "path_regex": "^/api/auth/me$",
    "query_keys": []
  }, {
    "pattern": "GET /api/reports/debt/filter-options",
    "handler": "debt.FilterOptions",
    "path_regex": "^/api/reports/debt/filter-options$",
    "query_keys": []
  },
  {
    "pattern": "GET /api/reports/debt/report",
    "handler": "debt.Report",
    "path_regex": "^/api/reports/debt/report$",
    "query_keys": ["date_from", "date_to", "entity_inns", "accounts", "currencies", "lens", "only_ico"]
  },
  {
    "pattern": "GET /api/reports/debt/drilldown",
    "handler": "debt.Drilldown",
    "path_regex": "^/api/reports/debt/drilldown$",
    "query_keys": ["date_from", "date_to", "company_inn", "partner_inn", "account", "contract", "currency", "lens"]
  },
  {
    "pattern": "GET /api/reports/debt/saved-filters",
    "handler": "debt.ListSavedFilters",
    "path_regex": "^/api/reports/debt/saved-filters$",
    "query_keys": []
  },
  {
    "pattern": "GET /api/plans/cfo-exp/{cardId}/form",
    "handler": "plans.CfoExpense.FormGet",
    "path_regex": "^/api/plans/cfo-exp/[0-9]+/form$",
    "query_keys": ["search", "group_pl", "country_company", "legal_entity", "sort", "dir", "code_pl", "code_cfo", "offset", "limit"]
  },
  {
    "pattern": "GET /api/plans/cfo-exp/{cardId}/validate",
    "handler": "plans.CfoExpense.Validate",
    "path_regex": "^/api/plans/cfo-exp/[0-9]+/validate$",
    "query_keys": []
  },
  {
    "pattern": "GET /api/plans/cfo-exp/{cardId}/export",
    "handler": "plans.CfoExpense.Export",
    "path_regex": "^/api/plans/cfo-exp/[0-9]+/export$",
    "query_keys": ["search", "group_pl", "country_company", "legal_entity", "sort", "dir", "code_pl", "code_cfo", "offset", "limit"]
  },
  {
    "pattern": "GET /api/plans/cfo-exp/{cardId}/registry/{sheet}",
    "handler": "plans.CfoExpenseRegistry.RegistryGet",
    "path_regex": "^/api/plans/cfo-exp/[0-9]+/registry/[A-Za-z0-9_-]+$",
    "query_keys": []
  }
]
