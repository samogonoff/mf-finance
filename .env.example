# === Finance Cabinet — пример переменных окружения ===
# Копируйте в .env и подставляйте значения. .env в git не коммитится.

# B24 OAuth-приложение Finance (отдельное от MP!)
# AUTH_URL / TOKEN_URL / DEFAULT_DOMAIN по умолчанию = mfportal.by
# (см. дефолты в nuxt.config.ts). Здесь только client_id/secret.
NUXT_PUBLIC_B24_CLIENT_ID=local.finance.xxx
B24_CLIENT_SECRET=замените_секретом_из_б24

# URL фронта Finance — куда B24 редиректит
NUXT_PUBLIC_AUTH_REDIRECT=http://finance.local/api/auth/b24/callback

# URL Go-API, как его видит фронт (ходит через nginx-фасад)
NUXT_PUBLIC_API_BASE=http://api.finance.local

# URL Go-API, как его видит Nuxt-сервер (SSR/nitro-routes, в частности
# server/api/auth/b24/callback.get.ts). Ходит по докер-сети, минуя nginx.
# Без этой переменной B24 OAuth-callback падает — см. CLAUDE.md «Bewegt-points».
NUXT_INTERNAL_API_BASE=http://go-api:8080

# Куда ведёт кнопка «Маркетплейсы» в шапке Finance (домен соседнего кабинета)
NUXT_PUBLIC_MP_URL=http://mp.local

# Раздел «Бюджетирование» — обособленный контур в своём репозитории
# (finance-budget), живёт за nginx на /budget/. "1" — показать раздел в
# переключателе разделов в шапке кабинета. Пусто/0 (дефолт) — пункт скрыт:
# пока контур не поднят, переход отдал бы только 502 от nginx.
# Роли доступа (ROLE_BUDGET / ROLE_BUDGET_ADMIN) выдаются в /admin/users
# и на видимость пункта влияют независимо от этого флага.
NUXT_PUBLIC_BUDGET_ENABLED=

# Cost-only режим (=1) — Nuxt отдаёт ТОЛЬКО раздел «Себестоимость»;
# используется в docker-compose.cost.yml. В основном контуре оставляем пустым/0.
NUXT_PUBLIC_COST_ONLY=

# Whitelist origin'ов для CORS на Go-API (CSV). По умолчанию "*" (dev).
# В prod указывайте только фактические домены фронта.
CORS_ORIGINS=http://finance.local,http://localhost:3001

# Postgres (используется внутри docker-compose)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Redis
REDIS_ADDR=redis:6379

cla# Bug tracker — каталог хранения скриншотов в Go-API (named volume bugtracker_uploads).
BUGTRACKER_UPLOADS_DIR=/var/lib/finance/uploads/bugtracker

# Внутренний канал service-to-service (Go-API ↔ python-cost).
# Если пусто — /internal/* в Go-API закрыты (fail-closed).
# В prod задаётся через docker config (см. ci-finance.yml).
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Дублирование уведомлений в Битрикс24 — через корпоративный mfportal site_api
# (тот же контракт, что у MP-кабинета: POST JSON {id, message} + Basic Auth).
# Канал включается, когда заданы ВСЕ три переменные; в dev оставляем пустыми,
# что автоматически делает доставку prod-only.
# Per-user отключение — чекбокс в /account → PATCH /api/account/notification-settings.
SITE_API_NOTIFY_URL=
SITE_API_NOTIFY_USER=
SITE_API_NOTIFY_PASSWORD=

# === Отчёт «Задолженность ВГО» ===
# Единственный источник — готовый расчётный слой FinDebt (вьюхи [Payments].
# [report].[FinDebt1/3] на OLAP-сервере 10.10.6.15), сверенный с 1С копейка-в-
# копейку (docs/reports/debt/findebt-verification.md). Свою свёртку НЕ считаем:
# ДЗ/КЗ-классификация, счета и просрочка приходят готовыми.
#
# DEBT_BACKEND:
#   - findebt (default) → отчёт читает CH finance.fact_findebt/_docs, залитый
#                         ETL'ом из FinDebt-вьюх (cmd/findebt-etl). Развязывает
#                         отчёт с живым OLAP.
#   - findebt-live      → прямое чтение FinDebt-вьюх из MSSQL (фолбэк/дебаг).
#   - findebt-docdate   → ВТОРОЙ поток для сверки (метод аналитика): суммы из сырых
#                         Debt_arh/Wholesales_arh (CH debt_facts/turnover_facts, где
#                         DocID уникален — FinDebt3 НЕ источник сумм), BYN/USD на дату
#                         документа через currency_daily (ASOF). Требует заливок
#                         MODE=currency и MODE=debtarh (ниже) и миграций CH 010+011.
#                         docs/reports/debt/vgo-doc-date-methodology.md.
#
# Поведение Go-API (см. go/internal/reports/debt/service.go):
#   - DEBT_MOCK=1 → фикстуры из mocks.go (dev без OLAP).
#   - DEBT_MOCK=0 + findebt → нужен CLICKHOUSE_HTTP_URL/USER (иначе go-api падает).
#   - DEBT_MOCK=0 + findebt-live → нужны MSSQL_PREMASTER_{SERVER,USER,PASSWORD}.
DEBT_MOCK=1
DEBT_BACKEND=findebt

# OLAP-сервер (10.10.6.15). Один коннект на весь сервер: на нём и БД FinDWH
# (Premaster — для модуля «Тактические планы»), и БД Payments с вьюхами FinDebt.
# Нужен при DEBT_BACKEND=findebt-live и для модуля планов. Идентификаторы БД/схем/
# таблиц валидируются regex `^[A-Za-z_][A-Za-z0-9_]*$` при старте.
MSSQL_PREMASTER_SERVER=
MSSQL_PREMASTER_PORT=1433
MSSQL_PREMASTER_DB=FinDWH
MSSQL_PREMASTER_USER=
MSSQL_PREMASTER_PASSWORD=

# БД Payments (та же OLAP-инстанция) — там живут FinDebt-вьюхи, схема report.
# FinDebt1 — свод остатков ДЗ/КЗ, FinDebt3 — документы со сроком/просрочкой.
# Имена вынесены в env, чтобы переключаться на копию без правки кода.
MSSQL_PAYMENTS_DB=Payments
MSSQL_FINDEBT_SCHEMA=report
MSSQL_FINDEBT1_TABLE=FinDebt1
MSSQL_FINDEBT3_TABLE=FinDebt3

# Фоновый инкремент FinDebt → CH (finance.fact_findebt), период в секундах.
# 0 → воркер выключен (dev — заливаем вручную через cmd/findebt-etl). На проде
# вьюхи FinDebt суточные, поэтому хватает нескольких часов, напр. 21600 (6 ч).
# Воркер stateless: берёт watermark (последний снэпшот) из CH и докатывает новые.
FINDEBT_SYNC_INTERVAL=0

# --- Пересчёт валют на Doc_Date (второй поток DEBT_BACKEND=findebt-docdate) ---
# Справочник валют (NAIM→KOD) и ежедневные курсы к BYN — источники курса на дату
# документа. Заливаются `cmd/findebt-etl` c MODE=currency в CH-таблицы
# finance.dim_valuta / finance.currency_daily (миграция clickhouse/migrations/010).
# FQN настраиваемы: справочники лежат на OLAP через linked server [SRV-SQL]; если
# он недоступен с нашего коннекта — подставь сюда прямой путь без правки кода.
MSSQL_VALUTA_FQN=[SRV-SQL].Gpartner.dbo.valuta
MSSQL_CURRENCY_DAILY_FQN=[SRV-SQL].Checks.dbo.CurrencyDaily
# Период фоновой синхронизации курсов (секунды). 0 → воркер выключен (dev —
# заливаем вручную: `cmd/findebt-etl` MODE=currency). Курсы посуточные → на проде
# хватает нескольких часов, напр. 21600 (6 ч). Актуально только для findebt-docdate.
CURRENCY_SYNC_INTERVAL=0

# Сырые факты метода аналитика (findebt-docdate): Debt_arh (остаток, дедуп по DocID)
# и Wholesales_arh (движения). Заливаются `cmd/findebt-etl` MODE=debtarh в CH-таблицы
# finance.debt_facts / finance.turnover_facts (миграция clickhouse/migrations/011);
# whitelist пар (UNPOrg,Acc) — из FinDebt1 на последнюю дату по каналу ВГО.
MSSQL_DEBT_ARH_FQN=[Payments].[dbo].[Debt_arh]
MSSQL_WHOLESALES_ARH_FQN=[Payments].[dbo].[Wholesales_arh]
# Имя колонки УНП контрагента в Debt_arh/Wholesales_arh, если она есть (валидируется
# как идентификатор). Пусто → контрагент только по Name, УНП в ключ агрегации не
# входит (свод по компания+счёт). Заполнить, когда подтвердим наличие УНП в источнике.
MSSQL_DEBT_ARH_CPARTY_COL=
# Период фонового reload'а debt_facts/turnover_facts (секунды). 0 → выключен (dev —
# вручную MODE=debtarh). Сырые таблицы посуточные, хватает нескольких часов.
DEBTARH_SYNC_INTERVAL=0

# --- Реплика FinDWH → ClickHouse findwh (для аналитиков) --------------------
# GLMF, Table_Fin_PL, ExRates из FinDWH копируются в CH-таблицы finance.findwh_* (миграция
# clickhouse/migrations/012). Коннект к MSSQL — те же MSSQL_PREMASTER_*, но свой
# пул на 2 соединения. Дизайн и замеры: docs/bi/findwh-etl.md.
#
# Как часто воркер go-api проверяет, не пора ли грузить (секунды). Сама загрузка —
# раз в сутки на таблицу: после того как DWH её собрал (≈08:00 GLMF, ≈08:30
# Table_Fin_PL) и если сегодня она ещё не грузилась (finance.findwh_etl_runs). 0 → воркер
# выключен (dev; вручную — cmd/findebt-etl MODE=findwh). Прод: 1800 (30 мин).
FINDWH_SYNC_INTERVAL=0
# БД источника на сервере MSSQL_PREMASTER_SERVER. Пусто → FinDWH.
FINDWH_DB=FinDWH
# Нижняя граница GLMF.Date, YYYY-MM-DD. Пусто → 2025-01-01 (раньше аналитикам не
# нужно). Если поднять — дни до новой границы удалятся из реплики при следующем прогоне.
FINDWH_GLMF_FROM=2025-01-01
# Сколько месяцев одной компании перегружать за один запрос к MSSQL. Каждый запрос —
# скан компании по кластерному индексу GLMF; больше месяцев → меньше сканов, но
# дольше теряется прогресс при обрыве. Пусто → 3.
FINDWH_GLMF_CHUNK_MONTHS=3
# Строк в одном INSERT в ClickHouse. Пусто → 20000.
FINDWH_BATCH=20000
# 1 → грузить только после успешного шага SQL Agent за сегодня (GLMF_exec,
# Update_Table_Fin_PL); нужен SELECT на msdb.dbo.sysjobs и msdb.dbo.sysjobhistory.
# 0 → без msdb: грузить после FINDWH_READY_AFTER_HOUR по часам сервера MSSQL.
# Пусто → 1.
FINDWH_READY_CHECK=1
# Час (по часам сервера MSSQL), раньше которого не грузим при FINDWH_READY_CHECK=0.
# Пусто → 9 (к этому времени DWH заканчивает ночную сборку и бэкап).
FINDWH_READY_AFTER_HOUR=9

# === ClickHouse =============================================================
# Слой ускорения отчёта: findebt-ETL (cmd/findebt-etl) заливает FinDebt-вьюхи в
# finance.fact_findebt/_docs, отчёт читает CH (см. clickhouse/migrations/008).
# В dev поднимается сервисом `clickhouse` (docker-compose.dev.yml): HTTP наружу
# 58123, нативный 59000.
#
# Пустой CLICKHOUSE_HTTP_URL → компоуз подставит docker-DNS http://clickhouse:8123.
# Снаружи docker (запуск с хоста) — http://localhost:58123.
#
# Эти три переменные использует и CI-джоб `migrations`: на каждом деплое он
# катит clickhouse/migrations/*.up.sql по HTTP (swarm/migrate-clickhouse.sh).
# Пустой CLICKHOUSE_HTTP_URL → шаг пропускается (CH-схема не накатится). Джоб
# бежит под `--network host`, поэтому на проде здесь должен быть РЕАЛЬНЫЙ
# host:port CH, доступный с CI-раннера, а не docker-DNS `clickhouse:8123`.
CLICKHOUSE_HTTP_URL=
CLICKHOUSE_USER=finance
CLICKHOUSE_PASSWORD=finance

# === Миграции (swarm/migrate.sh, CI-джоб `migrations`) ======================
# Все переменные ниже имеют дефолты в скрипте — пустые/незаданные значения
# безопасны. Задавать имеет смысл только при разборе инцидентов с накатом.
#
# lock_timeout в DSN мигратора: сколько ждать блокировку (таблицы ИЛИ advisory),
# прежде чем упасть. Защищает от вечного зависания на `ALTER TABLE`, который
# стоит в очереди за ACCESS EXCLUSIVE позади сессий python-cost/go-api.
# Пусто → 10s. Слишком большое значение вернёт часовые зависания job'а.
MIGRATE_LOCK_TIMEOUT=10s
# statement_timeout в DSN мигратора: потолок на ОДИН statement (не про ожидание
# блокировки, а про длительность самого DDL). Пусто → 300s. Ставить меньше
# опасно: тяжёлый CREATE INDEX на большой таблице будет рубиться на середине
# и оставлять БД dirty.
MIGRATE_STATEMENT_TIMEOUT=300s
# Preflight: возраст (в секундах) держателя advisory-лока, после которого он
# считается осиротевшим и прибивается pg_terminate_backend. В БД finance/cost
# advisory-локи берёт только golang-migrate, поэтому чужих жертв быть не может.
# Пусто → 60. 0 фактически отключает порог (убьёт и живой параллельный накат).
MIGRATE_UNLOCK_IDLE_SECONDS=60
# 1 → preflight сам снимает флаг dirty (force на version-1, миграция
# переприменяется; все наши миграции идемпотентны). 0 → только предупреждение,
# чинить руками `force-cost <version>`. Пусто → 1.
MIGRATE_AUTO_HEAL=1
# 1 → preflight прибивает осиротевшие advisory-локи. 0 → только показывает их
# в логе job'а (накат тогда упадёт на pg_advisory_lock). Пусто → 1.
MIGRATE_AUTO_UNLOCK=1
# Сколько раз пробовать `up` и пауза между попытками (сек). Между попытками
# скрипт снимает dirty и (если разрешено) убирает блокировщиков таблиц.
# Пусто → 3 попытки с паузой 15 с.
MIGRATE_UP_RETRIES=3
MIGRATE_RETRY_DELAY=15
# 1 → ПОСЛЕ неудачной попытки прибивать сессии, которые держат таблицы дольше
# MIGRATE_BLOCKER_AGE_SECONDS. Это отдельная от advisory-локов история:
# `ALTER TABLE` берёт ACCESS EXCLUSIVE и ждёт освобождения всех блокировок на
# таблице, а живой python-cost (запросы к cost_data_cache, refresh кэша на
# 960K строк) держит их дольше lock_timeout — накат падает с «canceling
# statement due to lock timeout». На первой попытке блокировщиков НЕ трогаем:
# нормальный деплой в них не упирается. Прерванный запрос приложение повторит,
# а застрявший накат блокирует весь деплой. 0 → только показывать их в логе
# (тогда накат так и будет падать). Пусто → 1 / 60 с.
MIGRATE_KILL_BLOCKERS=1
MIGRATE_BLOCKER_AGE_SECONDS=60

# === Модуль «Тактические планы» (docs/reports/plans/SPEC.md) ===
# VS0 (каркас) НЕ читает доп. env: доступ к /api/plans/* гейтится ролью
# ROLE_PLANS_USER/ADMIN (auth.roles), а не флагом. Переменные ниже подключаются
# следующими срезами (VS2+) — заведены заранее, чтобы прод-конфиг их видел.
#
# PLANS_MOCK=1 → фикстуры вместо OLAP/SQL (fallback, как DEBT_MOCK); по умолч. live.
PLANS_MOCK=0
# Источник факта/плана/штрафов МП — тот же сервер FinDWH, что у ВГО-отчёта:
# переиспользуем MSSQL_PREMASTER_* (см. блок «Задолженность ВГО»). ПОДТВЕРЖДЕНО
# probe'ом 2026-07: продажи/себестоимость МП лежат в БД Budgeting (плоские таблицы
# FormToLoad*, КодЦФО/КодPL/Дата/Значение, значения в BYN → форма пересчитывает в
# RUB через курс). Статей прямых затрат там НЕТ (ручной ввод + штрафы). Пусто → не тянется.
PLANS_MP_FACT_TABLE=Budgeting.dbo.FormToLoadFact   # факт МП (WB/1046/2026-05 = 13.63М BYN)
PLANS_MP_PLAN_TABLE=Budgeting.dbo.FormToLoadPlan    # план/стратегия МП (колонка «Стратегия»)
# Тактика-таргеты МП (колонка «Таргет» формы и свода). Probe 2026-07-25: покрывает
# 2025-01…2026-12 (включая будущие месяцы) и содержит 8006 «себестоимость по
# отпускным ценам», которой в ФАКТЕ нет с 2023-12. Пусто → колонка «Таргет» не тянется.
PLANS_MP_TAKT_TABLE=Budgeting.dbo.FormToLoaTaktTarget
# Штрафы МП: вью FinDWH FINDWHACCESSGROUP (Наименование LIKE '%Штраф%'), суммируем
# «Сумма без НДС_RUR» по CodeCFO площадок за месяц → строка «Штрафы» (CodePL=6600).
# ПОДТВЕРЖДЕНО probe'ом (WB 2026-05 = 589 737.33). Пусто → штрафы не тянутся.
# Скорректированное ТЗ (§6.2, §9.1, ответ C5) называет отдельный источник штрафов —
# DWH.dbo.wb_dimensions_penalty. Он поддержан: подставьте это имя вместо
# FINDWHACCESSGROUP, и запрос возьмёт рублёвую колонку того источника
# (различие только в имени колонки суммы, см. olap_mp.go penaltyRows).
PLANS_MP_PENALTIES_VIEW=FINDWHACCESSGROUP
# Стратегические доли статей прямых затрат МП по умолчанию (ТЗ доработок п. 2.1):
# форма МП считает статьи по ним, пока доля не переопределена в условиях площадки.
# Статьи (64/51/52/54/13/15/45/58/48/66) по ЦФО площадок есть только в ОПУ-витрине
# FinDWH (в FormToLoadPlan/VFORMTOLOADPLAN по МП — лишь продажи/себестоимость,
# probe 13.10.2026). Доля = статья ÷ |1006| за месяц тактики, AmountBYN.
# Пусто или PLANS_MOCK=1 → фикстура; недоступный источник → доли пустые, форма
# пишет «доля не задана» (расчёта от нуля нет).
PLANS_MP_ARTICLE_FACT_TABLE=FinDWH.dbo.Table_Fin_PL
# Сценарий витрины со стратегией (значение колонки Scenario). Дефолт «НовСтрат»;
# если стратегию перезальют под другим именем — поменять здесь, без релиза.
PLANS_MP_STRATEGY_SCENARIO=НовСтрат
# Контроль источников модуля планов после выката (ТЗ доработок п. 1.1): каждая
# загрузка источника (слои снимка факта МП, источники формы розницы) пишется в
# plans_source_run и сравнивается с предыдущим успешным прогоном. Падение строк
# больше порога, %, или ошибка источника — warn в лог (ELK) + уведомление
# администраторам (один раз на переходе «был здоров → сломался»). Дефолт 30;
# пусто/нечисло → 30.
PLANS_SOURCE_DROP_ALERT_PCT=30
# Аудит модуля (AUD): =1 → писать plans_audit_event.
PLANS_AUDIT_ENABLED=0
# Заморозка устаревшей ветки формы МП /api/plans/mp/{form,compute,copy,formula,
# export,import} (первая генерация: 2 editable-строки 1046/8006, движок calc.go).
# 0 (дефолт) → эти ручки отдают 410 Gone; актуальная форма живёт на
# /api/plans/tasks/{taskId}/mp-form. =1 — аварийный откат на legacy.
PLANS_LEGACY_MP_API=0
#
# --- Публикация утверждённого плана в приёмники Budgeting (ТЗ МП §9.3 / Розница §7.2) ---
# 0 (дефолт) → работает ТОЛЬКО режим dry-run: сервис собирает строки, применяет
# маппинг (таблица publish_mapping) и сверяет суммы с приёмником, ничего не пишет.
# Это и есть инструмент, которым BI подтверждает открытые вопросы §12 (какой
# «Параметр» писать, агрегат по группе 250/480 или детализация по площадкам, кто
# заполняет BYN-пару). =1 → разрешена запись на утверждении этапа 1.4.
# ВНИМАНИЕ: у приёмников нет первичного ключа. Сервис делает DELETE по логическому
# ключу + INSERT в одной транзакции и сверяет «введено = записано», но уникальный
# индекс на (Параметр, Страна, КодЦФО, КодPL, Дата) на стороне BI всё равно нужен.
PLANS_PUBLISH_ENABLED=0
# Белый список таблиц-приёмников: имя таблицы приходит из данных маппинга, поэтому
# запись возможна только в перечисленные здесь. Через запятую.
PLANS_PUBLISH_TARGETS=Budgeting.dbo.VFORMTOLOADTAKTTARGET,Budgeting.dbo.FormToLoaTaktTarget
# Песочница приёмника (миграция 0041, таблица publish_sandbox в БД finance).
# 0 (дефолт) → при недоступном Budgeting публикация отвечает «приёмник недоступен»
# и остаётся предпросмотром. =1 → тот же путь записи выполняется в PG: DELETE по
# логическому ключу + INSERT в транзакции, обратное чтение суммы, контроль
# «Σ введено − Σ записано = 0», идемпотентность (ключ с префиксом sandbox:, так
# что реальную публикацию той же версии прогон не блокирует), перевод карточки в
# published/publish_failed. Нужна, чтобы проверить функционал целиком без VPN к
# Budgeting.
# ТОЛЬКО dev/тест: карточка станет published, хотя в Budgeting записи НЕ будет
# (в листе согласования и в отчёте это помечено словом «ПЕСОЧНИЦА»). Если задан
# PLANS_PUBLISH_ENABLED=1 и MSSQL доступен — пишем в реальный приёмник, песочница
# игнорируется. Белый список PLANS_PUBLISH_TARGETS действует и здесь.
PLANS_PUBLISH_SANDBOX=0
#
# --- Справочник статей PL (правки ТЗ 02.09.2026, часть 5) ---
# Budgeting.dbo.CodePL, 423 записи: GroupPL, CodePL, Expense, SpecialAccess,
# CF_item и пять колонок НДС (VAT_BY/RU/KZ/UZ/TR). НДС хранится КОЭФФИЦИЕНТОМ
# «1 + ставка» (BY 1,20 · RU 1,22 · KZ 1,16 · UZ 1,12 · TR 1,00); 1,00 означает
# «налог по статье не начисляется». Нормативная ставка нужна как ВЕРХНЯЯ ГРАНИЦА
# проверки: расчёт идёт по эффективной ставке, применять 22 % ко всей выручке
# нельзя. Пусто или нет MSSQL → справочник остаётся на сиде PLLineSeed.
PLANS_CODEPL_TABLE=Budgeting.dbo.CodePL
#
# --- Снимок факта МП (правка ТЗ 02.09.2026 МП §12) ---
# 1 (дефолт) → форма читает ТАБЛИЦУ СНИМКА (mp_fact_snapshot) с отметкой «данные
# актуальны на …», а не OLAP вживую. Живое чтение запрещено ТЗ: больше двухсот
# процедур в DWH/FinDWH/MP перезаливают таблицы через TRUNCATE, суммы плавают в
# динамике, и согласующий увидел бы не то, что видел заполняющий. Снимок питается
# регламентом раз в сутки и ручкой POST /api/plans/admin/mp-fact-snapshot (админ).
# Снимок не собран → форма открывается и говорит об этом словами, а не показывает
# нули (новый период можно начинать заполнять до первого прогона).
# 0 — аварийный откат на прямое чтение источника.
PLANS_FACT_SNAPSHOT=1
# Интервал регламента снимка, секунды. Дефолт — сутки: данные отчётного месяца
# готовы не раньше 20-го числа текущего, чаще собирать нечего.
PLANS_FACT_SNAPSHOT_INTERVAL=86400
#
# --- Подсказки к полям ввода формы МП (правки ТЗ 02.09.2026, часть 1) ---
# Принцип: если в форме Excel значение занесено РУКАМИ, в веб-форме это поле
# ввода, и автоподстановки нет даже при найденном источнике. Источник показывается
# подсказкой рядом с полем (значение + расхождение), без подстановки и без
# блокировки. Пусто или нет MSSQL → подсказок не будет, поля остаются полями ввода.
#
# %СПП: подсказка = SUM(spp × SALES_RUB)/SUM(SALES_RUB) по истории цен и весам
# продаж (ключ EAN), значения spp вне 0…100 отбрасываются. Считается регламентом
# раз в сутки движком синхронизации справочников: в истории 112 млн строк.
PLANS_MP_SPP_TABLE=MP.dbo.WB_Price_SPP_Analysis
PLANS_MP_SALES_TABLE=MP.dbo.sales
# Штрафы: габаритные штрафы Wildberries. Берём из DWH (2 709 437 строк, свежая
# загрузка), а НЕ копию в MP — она встала 24.04.2026 (53 842 строки). Это ЧАСТЬ
# штрафов, а не итог: общего реестра штрафов в базах нет, поэтому в форме штрафы
# вводятся руками, а подсказка идёт с этой оговоркой.
PLANS_MP_PENALTY_TABLE=DWH.dbo.wb_dimensions_penalty
#
# --- Режим гейта отправки форм плана ---
# Ответ аналитика 41 (10.09.2026): контрольные сверки и валидации считаются ВСЕГДА,
# а блокировка отправки на согласование — переключаемая настройка.
#   пусто / 0 → мягкий режим (по умолчанию): замечания и расхождения показываются
#               плашкой в форме и согласующему, но процесс не держат. Так стенд не
#               встаёт из-за расхождения, которое ещё разбирают;
#   1         → жёсткий: форма с блокирующими замечаниями на согласование не уходит.
#               Включать к промышленной эксплуатации.
# Отправка с замечаниями пишется в лог go-api в обоих режимах.
PLANS_SUBMIT_STRICT=
# Шлюз РБ/РФ/КЗ/УЗ перед Сипаровой: включён по умолчанию.
# Только для тестового прогона одной страны можно явно поставить 0.
PLANS_RETAIL_COUNTRY_GATE=1
# Утверждённая тактика в национальной валюте; не подменяется стратегией.
PLANS_RETAIL_APPROVED_TABLE=Budgeting.dbo.VFORMTOLOADTAKTTARGET
# Национальная пара FormToLoadFact: сравнения в валюте формы.
PLANS_RETAIL_COMPARISON_FACT_TABLE=Budgeting.dbo.VFORMTOLOADFACT
# НовСтрат: необязательная плоская таблица с колонками плана (Дата, КодЦФО,
# Значение, Параметр, ГруппыЦФО1, Страна) и Scenario. В VFORMTOLOADPLAN
# Scenario нет. Пусто (по умолчанию): сценарий читается из
# FinDWH.dbo.Table_Fin_PL (Scenario = 'НовСтрат', ПРОДАЖИ, нац. валюта).
PLANS_RETAIL_NEW_STRATEGY_TABLE=
#
# --- Форма «Расходы ЦП» (TPL-CFO-EXP, этап 1.5) ---
# ТЗ: docs/reports/plans/tz-stage-1.5-2026-09-09.md §2. Источники читаются тем же
# MSSQL-пулом, что у МП и розницы (MSSQL_PREMASTER_*). При PLANS_MOCK=1 или
# недоступном MSSQL форма работает на фикстурах exp_mock.go (5 магазинов РБ и
# 5 площадок МП с фактом прошлого года) — этого хватает для разработки без VPN.
#
# Основной источник затрат — ХРАНИМАЯ ПРОЦЕДУРА без параметров (ТЗ §2.1), база
# BUDGETING. Отбор строк (коды PL 50/93/01, отсечка по 31.12.2023, переименование
# сценариев) выполняется в коде: параметров у процедуры нет.
# Пусто → строки формы не соберутся, форма откроется пустой.
PLANS_EXP_COSTS_PROC=ZATRATY_DLYA_OKSANY_BYSTRYE
# Справочник ЦФО этапа 1.5 (ТЗ §2.4): город, тип магазина, РМ, ЮЛ — атрибуты,
# которых нет в строке затрат. Пусто → строки соберутся без этих атрибутов
# (фильтры §7.1 по городу/типу/РМ станут пустыми, форма продолжит работать).
PLANS_EXP_CFO_TABLE=FinDWH.dbo.[001 CodeCFO]
#
# --- Форма «Розница» (TPL-TO-RETAIL, ТЗ Розница §6) ---
# Источники читаются тем же MSSQL-пулом, что у МП (MSSQL_PREMASTER_*).
# При PLANS_MOCK=1 или недоступном MSSQL форма работает на фикстурах (≈20 магазинов
# РБ с фактом 2025–2026) — этого достаточно для разработки и тестов.
# Справочник магазинов: 001 CodeCFO, фильтр по группе. ВНИМАНИЕ: в справочнике
# группа называется «Магазины», а в таблице плана — «3.Магазины»; это РАЗНЫЕ
# значения и они задаются отдельными переменными (сопоставление справочником, а не
# строковым сравнением — требование ТЗ §6 п.1).
PLANS_RETAIL_STORE_TABLE=FinDWH.dbo.[001 CodeCFO]
PLANS_RETAIL_STORE_GROUP=Магазины
# Факт продаж по офлайн-рознице. Эталонность подтверждена правками ТЗ 02.09.2026
# §18: v_sales_and_COGS_all равен сумме четырёх канальных объектов до копейки, и
# каждая форма читает СВОЙ канальный объект (колонки канала в сводном нет —
# разделить можно только по DbAnalytics1). Имя оставлено в env, чтобы переключить
# канал без релиза.
PLANS_RETAIL_FACT_TABLE=FinDWH.dbo.sales_and_COGG_from_FOX_offline_retail
# PLANS_RETAIL_FACT_COLUMNS больше нет: правки ТЗ §4 назвали колонки точно
# (Month, Country, CodeCFO, CodePL, GroupPL, Company/CompanyID, DbAnalytics1,
# PLDescrBK + AmountWithVAT/WOVAT × Currency/BelRub). Запрос зависит от СМЫСЛА
# колонок (фильтр по PLDescrBK, выручка по модулю, себестоимость только в BYN),
# поэтому настраивать их через env стало вредно — они зафиксированы в коде.
# Стратегия в НАЦИОНАЛЬНОЙ валюте (в BYN-паре FormToLoadPlan числа другие).
PLANS_RETAIL_STRATEGY_TABLE=Budgeting.dbo.VFORMTOLOADPLAN
PLANS_RETAIL_STRATEGY_GROUP=3.Магазины
# История плана по магазинам (только ЧТЕНИЕ: таблицу используют другие отчёты,
# писать в неё нельзя без отдельного решения BI — ТЗ §7.2).
# База Checks с этими таблицами живёт на SRV-SQL (10.10.6.107), а не на OLAP
# (10.10.6.15), поэтому читаем через linked server [SRV-SQL] на OLAP — так же,
# как MSSQL_VALUTA_FQN. Без префикса запрос падает («Checks.dbo.plan_saler_st»
# на OLAP нет), KLIENT_ID магазинов в форме остаётся пустым.
PLANS_RETAIL_PLAN_HISTORY_TABLE=[SRV-SQL].Checks.dbo.plan_saler_st
PLANS_RETAIL_PLAN_HISTORY_NEW_TABLE=[SRV-SQL].Checks.dbo.plan_saler_st_new_stores
# Верхняя граница значения ячейки плана по стране (V-02), формат BY=100000000,RU=…
# Пусто → граница не проверяется (проверка «значение ≥ 0» работает всегда).
PLANS_RETAIL_VALUE_LIMITS=
#
# PLANS_RETAIL_RECON_BLOCKING — запрещать ли отправку формы розницы на
# согласование, когда контрольная сверка V-05 не сошлась. Пусто/0 (по умолчанию,
# решение 08.09.2026) — расхождение показывается предупреждением в отчёте
# проверки, но работу над формой не останавливает: на стенде сверки расходились
# из-за самих данных факта. 1 — прежнее поведение, отправка блокируется.
PLANS_RETAIL_RECON_BLOCKING=
#
# --- Справочники Лисы (ТЗ §«Справочники из Лисы») ---
# «Лиса» = MSSQL-БД Gpartner (бывший FoxPro-учёт). Источник справочников
# dir_store_to (s_klient), dir_fx_rate (valuta1) и факта ТО. Если FOX_HOST пуст
# ИЛИ LISA_MOCK=1 — синхронизация Лисы идёт из фикстур (как PLANS_MOCK).
# Пустой FOX_HOST в проде → справочники Лисы получат sync_status=error
# («lisa: not configured») и НЕ обновятся — задавай креды в проде.
FOX_HOST=
FOX_PORT=1433
FOX_DB=          # прод: Gpartner
FOX_USER=
FOX_PASSWORD=@Line
LISA_MOCK=0# 1 → синхронизация справочников Лисы из фикстур, без сети
# Период фоновой синхронизации справочников Лиса/1С (cron), сек. По умолч. 1 ч.
PLANS_SYNC_INTERVAL=3600
# Дефолтный TTL Redis-кэша строк справочника, сек (переопределяется per-dir в БД).
PLANS_DIR_CACHE_TTL=3600
# Inbound-вебхук B24 с правом user.get — админ-импорт пользователей по ID
# (догрузка сотрудников, ещё не заходивших; директора/ТОПы ЮЛ). Пусто → импорт
# отдаёт 503. Формат: https://<домен>/rest/<user_id>/<token>/
B24_USERGET_WEBHOOK=

# === Superset (BI-контур, swarm/docker-compose.superset.yml) ===================
# Поднимается отдельно: `cd swarm && make superset-up`. Контур изолирован —
# своя метабаза Postgres, свой Redis, свои порты. Ни одна переменная ниже не
# влияет на основной контур и на «Себестоимость».
#
# Ключ подписи сессий Superset. Пусто/дефолт → Superset откажется стартовать
# в production-режиме. В prod задаётся через docker config, НЕ коммитится.
SUPERSET_SECRET_KEY=dev-superset-secret-change-me

# Метабаза Superset (дашборды, чарты, датасеты, пользователи). Это НЕ данные
# отчётов — источники подключаются отдельно, см. SUPERSET_DB_*_URI ниже.
SUPERSET_POSTGRES_USER=superset
SUPERSET_POSTGRES_PASSWORD=superset
SUPERSET_POSTGRES_DB=superset
SUPERSET_POSTGRES_PORT=55434

# Порты контура. 8088 занят nginx-cost, 8089/8091 — go-api/python-cost,
# поэтому UI Superset висит на 8093.
SUPERSET_PORT=8093
SUPERSET_REDIS_PORT=63792

# Публичный URL инстанса. Используется для permalink'ов, скриншотов и ссылок,
# которые отдаёт MCP (explore link, SQL Lab link). Соврёте — агент выдаст
# нерабочие URL.
SUPERSET_PUBLIC_URL=http://localhost:8093/

# Первый администратор. Создаётся один раз сервисом superset-init;
# смена пароля здесь уже созданного пользователя не меняет.
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@localhost

# Лимиты выборки: ROW_LIMIT — дефолт для чартов, SQL_MAX_ROW — потолок SQL Lab.
SUPERSET_ROW_LIMIT=50000
SUPERSET_SQL_MAX_ROW=100000
SUPERSET_WEBSERVER_TIMEOUT=300

# HTTPS-заголовки и CSP. В dev по http ломают UI → 0. В prod за nginx → 1.
SUPERSET_TALISMAN_ENABLED=0
SUPERSET_ENABLE_PROXY_FIX=1

# Роль для новых пользователей. Gamma = «смотреть, не ломать».
SUPERSET_DEFAULT_ROLE=Gamma

# --- Источники данных ---------------------------------------------------------
# Подставляются вместо ${...}-плейсхолдеров в swarm/superset/assets/databases/*.yaml
# на импорте ассетов (make superset-assets-import). Именно поэтому в git лежат
# плейсхолдеры, а не строки соединения: пароли не коммитятся.
#
# host.docker.internal — БД других контуров видны через host-порты, а не по
# докер-сети. Так Superset поднимается независимо от `make up`/`make cost-up`,
# а в prod те же переменные указывают на реальные хосты.
SUPERSET_DB_CH_URI=clickhousedb://finance:finance@host.docker.internal:58123/finance
SUPERSET_DB_PG_FINANCE_URI=postgresql+psycopg2://finance:finance@host.docker.internal:55432/finance
SUPERSET_DB_PG_COST_URI=postgresql+psycopg2://cost:cost@host.docker.internal:55433/cost
# MSSQL OLAP/Premaster (10.10.6.15 / 10.10.6.107) — нужен VPN. Без VPN оставьте
# пустым: источник просто выпадет из бандла при импорте.
# Формат: mssql+pymssql://USER:PASSWORD@10.10.6.15:1433/Payments
SUPERSET_DB_MSSQL_URI=

# 1 → незаполненный ${...}-плейсхолдер РОНЯЕТ импорт ассетов. В dev 0 (нет VPN
# к MSSQL — это норма), в CI/prod обязательно 1, иначе выкатим дашборд без
# источника и узнаем об этом от пользователя.
SUPERSET_ASSETS_STRICT=0

# --- MCP-сервер Superset ------------------------------------------------------
# Встроен в Superset (модуль superset.mcp_service, требует fastmcp — стоит в
# swarm/superset/Dockerfile). Отдельный контейнер superset-mcp,
# эндпоинт http://localhost:5008/mcp — он прописан в корневом .mcp.json.
MCP_SERVICE_PORT=5008

# RBAC: MCP-инструменты работают под правами пользователя Superset. Не выключать.
MCP_RBAC_ENABLED=1

# 0 → аутентификации нет, все вызовы идут от имени MCP_DEV_USERNAME. Допустимо
# ТОЛЬКО в dev на localhost. В prod обязательно 1 + MCP_JWT_SECRET (HS256) или
# MCP_JWKS_URI (RS256): иначе любой, кто дотянулся до порта 5008, получает
# права админа Superset над всеми подключёнными БД.
MCP_AUTH_ENABLED=0
MCP_DEV_USERNAME=admin
MCP_JWT_SECRET=
MCP_JWKS_URI=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=

# Число процессов Celery-воркера (async-запросы SQL Lab и чартов). Воркер
# обязателен: у всех подключений allow_run_async: true, без него SQL Lab
# отвечает 500 «Results backend is not configured».
SUPERSET_WORKER_CONCURRENCY=4
# === Логи в ELK (Logstash) ==================================================
# Дублирование структурных логов в Logstash по TCP, кодек json_lines. Базовый
# канал — stdout (его собирает docker) — остаётся всегда; ELK дополнительный.
# Отправка асинхронная и НИКОГДА не блокирует обработку запросов: недоступный
# Logstash не тормозит сервис и не роняет stdout, строки просто отбрасываются
# (счётчик потерь раз в минуту уходит в лог — рост = канал в ELK ослеп).
# Читают ВСЕ рантаймы основного контура из ЭТИХ ЖЕ переменных (без префикса NUXT_):
#   - Go-API (slog): go/internal/logship, service=finance-api;
#   - Nuxt/Nitro: nuxt/server/utils/logstash.ts, service=finance-nuxt. Читает
#     process.env НАПРЯМУЮ в рантайме, поэтому префикс NUXT_ тут НЕ нужен и
#     переменная общая с Go (через runtimeConfig потребовался бы NUXT_);
#   - python-analytics: python/app/logship.py, service=finance-analytics
#     (только dev-контур — в прод-стек песочница не входит).
# Контур «Себестоимость» настраивается отдельно — те же имена в
# python/cost/.env (service=finance-cost, python/cost/app/logship.py).
# LOGSTASH_HOST пусто → трансляция выключена, только stdout.
# LOGSTASH_PORT пусто при заданном HOST → 5044.
# Проверка канала и тестовые строки для настройки индекса: cd swarm && make logship-test.
LOGSTASH_HOST=
LOGSTASH_PORT=
