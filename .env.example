# === Finance Cabinet — пример переменных окружения ===
# Копируйте в .env и подставляйте значения. .env в git не коммитится.

# B24 OAuth-приложение Finance (отдельное от MP!)
# AUTH_URL / TOKEN_URL / DEFAULT_DOMAIN по умолчанию = mfportal.by
# (см. дефолты в nuxt.config.ts). Здесь только client_id/secret.
NUXT_PUBLIC_B24_CLIENT_ID=local.finance.xxx
B24_CLIENT_SECRET=замените_секретом_из_б24

# URL фронта Finance — куда B24 редиректит
NUXT_PUBLIC_AUTH_REDIRECT=http://finance.local/api/auth/b24/callback

# URL Go-API, как его видит фронт (ходит через nginx-фасад)
NUXT_PUBLIC_API_BASE=http://api.finance.local

# URL Go-API, как его видит Nuxt-сервер (SSR/nitro-routes, в частности
# server/api/auth/b24/callback.get.ts). Ходит по докер-сети, минуя nginx.
# Без этой переменной B24 OAuth-callback падает — см. CLAUDE.md «Bewegt-points».
NUXT_INTERNAL_API_BASE=http://go-api:8080

# Куда ведёт кнопка «Маркетплейсы» в шапке Finance (домен соседнего кабинета)
NUXT_PUBLIC_MP_URL=http://mp.local

# Cost-only режим (=1) — Nuxt отдаёт ТОЛЬКО раздел «Себестоимость»;
# используется в docker-compose.cost.yml. В основном контуре оставляем пустым/0.
NUXT_PUBLIC_COST_ONLY=

# Whitelist origin'ов для CORS на Go-API (CSV). По умолчанию "*" (dev).
# В prod указывайте только фактические домены фронта.
CORS_ORIGINS=http://finance.local,http://localhost:3001

# Postgres (используется внутри docker-compose)
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance

# Redis
REDIS_ADDR=redis:6379

cla# Bug tracker — каталог хранения скриншотов в Go-API (named volume bugtracker_uploads).
BUGTRACKER_UPLOADS_DIR=/var/lib/finance/uploads/bugtracker

# Внутренний канал service-to-service (Go-API ↔ python-cost).
# Если пусто — /internal/* в Go-API закрыты (fail-closed).
# В prod задаётся через docker config (см. ci-finance.yml).
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

# Дублирование уведомлений в Битрикс24 — через корпоративный mfportal site_api
# (тот же контракт, что у MP-кабинета: POST JSON {id, message} + Basic Auth).
# Канал включается, когда заданы ВСЕ три переменные; в dev оставляем пустыми,
# что автоматически делает доставку prod-only.
# Per-user отключение — чекбокс в /account → PATCH /api/account/notification-settings.
SITE_API_NOTIFY_URL=
SITE_API_NOTIFY_USER=
SITE_API_NOTIFY_PASSWORD=

# === Отчёт «Задолженность ВГО» — MSSQL ===
# Источник live-данных: ТАБЛИЦА [FinDWH].[dbo].[Premaster1C] на OLAP-сервере 10.10.6.15.
# Premaster1C — это таблица в БД FinDWH (а не отдельная БД!). Имена БД/схемы/таблиц
# вынесены в env, чтобы можно было быстро переключиться на снэпшот
# (например MSSQL_PREMASTER_TABLE=Premaster1C_20260514) без правки кода.
#
# Поведение Go-API (см. go/internal/reports/debt/service.go):
#   - DEBT_MOCK=1                     → отдаём фикстуры из mocks.go, MSSQL не дёргаем.
#   - DEBT_MOCK=0 + все MSSQL_PREMASTER_{SERVER,USER,PASSWORD} заданы → live-режим.
#   - DEBT_MOCK=0 и любая из учёток пуста → /api/reports/debt/* отвечают 500
#     с «premaster repo not configured». В prod это значит «забыл прокинуть env».
#
# Идентификаторы (DB/SCHEMA/TABLE/OBJECTS_TABLE) подставляются в SQL напрямую,
# поэтому валидируются regex `^[A-Za-z_][A-Za-z0-9_]*$` при старте — невалидное
# значение валит go-api с понятной ошибкой.
DEBT_MOCK=1
MSSQL_PREMASTER_SERVER=
MSSQL_PREMASTER_PORT=1433
MSSQL_PREMASTER_DB=FinDWH
MSSQL_PREMASTER_SCHEMA=dbo
MSSQL_PREMASTER_TABLE=Premaster1C
MSSQL_PREMASTER_OBJECTS_TABLE=Objects
# Counterparty1C — обогащает отчёт именем/каналом/менеджером контрагента
# (LEFT JOIN после агрегации, дёшево). Закрывает имена партнёров, попавших в ВГО
# по ICO=1 вне наших 15 ЮЛ (иначе показывался голый ИНН). Пусто → не джойнить.
MSSQL_PREMASTER_COUNTERPARTY_TABLE=Counterparty1C
MSSQL_PREMASTER_USER=
MSSQL_PREMASTER_PASSWORD=

# Витрина расчётов Payments (та же OLAP-инстанция, отдельная БД). Таблица Docs
# несёт PaymentDate/Delay → даёт «дата оплаты по договору» и «просрочка в днях»
# в drill-down документа. Мост: Premaster1C.DocID = Payments.dbo.Docs.ID
# (подтверждён аналитиком, docs/reports/debt/payments-source-map.md §5).
# Джойн ОПЦИОНАЛЬНЫЙ и LEFT: если MSSQL_PAYMENTS_DB пуст — drill-down работает
# как раньше, поля payment_due_date/overdue_days остаются пустыми (просрочку не
# показываем). Логину MSSQL_PREMASTER_USER нужен SELECT на [Payments].[dbo].[Docs].
MSSQL_PAYMENTS_DB=Payments
MSSQL_PAYMENTS_DOCS_SCHEMA=dbo
MSSQL_PAYMENTS_DOCS_TABLE=Docs

# Revenue-оверлей из P&L-матриц (opt-in). При DEBT_REVENUE_OVERLAY=1 на старте
# читаем [001 Mapping PL by BK] ⋈ [002 CodePL] ⋈ [CompaniesMF] и помечаем
# revenue-счета (GroupPL='ПРОДАЖИ') по странам — закрывает «какие субсчета =
# выручка» (analyst-handoff §4), в т.ч. для стран без хардкод-плана счетов.
# Только revenue: ДЗ/КЗ-баланс не трогает (его в P&L-матрицах нет).
# При любой ошибке загрузки — фолбэк на хардкод-классификацию, сервис стартует.
# По умолчанию выключено (0): нужна проверка SQL-допущений на живой OLAP.
DEBT_REVENUE_OVERLAY=0
MSSQL_PREMASTER_MAPPING_PL_TABLE=001 Mapping PL by BK
MSSQL_PREMASTER_CODEPL_TABLE=002 CodePL
MSSQL_PREMASTER_COMPANIES_TABLE=CompaniesMF

# === ClickHouse =============================================================
# Аналитический слой для отчётов финансиста. Питается ETL'ом из Premaster1C
# (см. docs/reports/debt/clickhouse-design.md). В dev-контуре поднимается
# сервисом `clickhouse` (docker-compose.dev.yml). HTTP-порт наружу 58123, нативный 59000.
#
# DEBT_BACKEND переключает источник свёртки отчёта «Задолженность ВГО»:
#   - mssql (default) → live из Premaster1C через repo_premaster.go
#   - ch              → CH-снэпшот через repo_clickhouse.go (drilldown остаётся в MSSQL)
DEBT_BACKEND=mssql
#
# Пустой CLICKHOUSE_HTTP_URL → компоуз подставит docker-DNS http://clickhouse:8123.
# Снаружи docker (запуск с хоста) — http://localhost:58123.
#
# Эти три переменные использует и CI-джоб `migrations`: на каждом деплое он
# катит clickhouse/migrations/*.up.sql по HTTP (swarm/migrate-clickhouse.sh).
# Пустой CLICKHOUSE_HTTP_URL → шаг пропускается (CH-схема не накатится). Джоб
# бежит под `--network host`, поэтому на проде здесь должен быть РЕАЛЬНЫЙ
# host:port CH, доступный с CI-раннера, а не docker-DNS `clickhouse:8123`.
CLICKHOUSE_HTTP_URL=
CLICKHOUSE_USER=finance
CLICKHOUSE_PASSWORD=finance
