FROM node:20-alpine

WORKDIR /var/www/nuxt_app

# Дополнительные пакеты для нативных deps (chokidar и пр.)
RUN apk add --no-cache python3 make g++ bash wget

ENV NUXT_HOST=0.0.0.0 \
    NUXT_PORT=3000

# Зависимости и dev-server поднимаются по факту монтирования исходников.
CMD ["sh", "-c", "npm install && npm run dev -- --hostname 0.0.0.0 --port 3000"]
