# === Раздел "Себестоимость" — окружение разработчика ===
# Изолированный контур: своя БД, свой API-контейнер, свой env.
# Скопируйте файл в python/cost/.env и подправьте под себя.
# Этот .env читается только swarm/docker-compose.cost.yml — основной .env проекта он не затрагивает.

# ── Локальная Postgres раздела (только аудит изменений и т.п.) ────────────────
COST_POSTGRES_USER=cost
COST_POSTGRES_PASSWORD=cost
COST_POSTGRES_DB=cost
COST_POSTGRES_PORT=55433
COST_DATABASE_URL=postgres://cost:cost@postgres-cost:5432/cost

# ── Внешние SQL Server'ы (источники бизнес-данных) ────────────────────────────
# Берётся напрямую из var/original/.env. Если нет VPN — оставьте dummy,
# фронт будет показывать ошибку на первом fetch'е, но контур поднимется.
MSSQL_DRIVER={ODBC Driver 18 for SQL Server}

# CostHistory — основная база (Checks)
MSSQL_SERVER_IP=10.10.6.107
MSSQL_DATABASE=Checks
MSSQL_USER=zvm
MSSQL_PASSWORD=180575

# Справочник уровней цен (та же машина, другая БД)
GPARTNER_DATABASE=Gpartner

# OLAP — приёмник изменений (FinSandBox.CostHistory_Changes)
OLAP_SERVER_IP=10.10.6.15
OLAP_DATABASE=FinSandBox
OLAP_USER=sa
OLAP_PASSWORD=11-future

# ── Порты, проброшенные на хост ───────────────────────────────────────────────
COST_API_PORT=8091
COST_NUXT_PORT=3002
COST_NGINX_PORT=8088
COST_API_PREFIX=/api/cost

# Если 1 — Nuxt запускается в режиме "только этот раздел":
#   - skip auth-гейта,
#   - в сайдбаре только пункт «Себестоимость»,
#   - $fetch ходит через nginx-cost (на порту COST_NGINX_PORT).
NUXT_PUBLIC_COST_ONLY=1

# Если 1 — backend отдаёт мок-данные вместо MSSQL/OLAP.
# Нужно, когда у разработчика нет VPN до 10.10.6.107/15: фильтры,
# агрегаты, детали, уровни цен берутся из python/cost/app/mocks.py.
# save-changes/save-batch в моке пишут только в локальный postgres-cost.
COST_MOCK=1
