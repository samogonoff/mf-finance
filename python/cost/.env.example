# === Раздел "Себестоимость" — окружение разработчика ===
# Изолированный контур: своя БД, свой API-контейнер, свой env.
# Скопируйте файл в python/cost/.env и подправьте под себя.
# Этот .env читается только swarm/docker-compose.cost.yml — основной .env проекта он не затрагивает.

# ── Локальная Postgres раздела (только аудит изменений и т.п.) ────────────────
COST_POSTGRES_USER=cost
COST_POSTGRES_PASSWORD=cost
COST_POSTGRES_DB=cost
COST_POSTGRES_PORT=55433
COST_DATABASE_URL=postgres://cost:cost@postgres-cost:5432/cost

# ── Внешние SQL Server'ы (источники бизнес-данных) ────────────────────────────
# Берётся напрямую из var/original/.env. Если нет VPN — оставьте dummy,
# фронт будет показывать ошибку на первом fetch'е, но контур поднимется.
MSSQL_DRIVER={ODBC Driver 18 for SQL Server}

# CostHistory — основная база (Checks)
MSSQL_SERVER_IP=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# Справочник уровней цен (та же машина, другая БД)
GPARTNER_DATABASE=Gpartner

# OLAP — приёмник изменений (FinSandBox.CostHistory_Changes)
OLAP_SERVER_IP=
OLAP_DATABASE=
OLAP_USER=
OLAP_PASSWORD=

# ── Порты, проброшенные на хост ───────────────────────────────────────────────
COST_API_PORT=8091
COST_NUXT_PORT=3002
COST_NGINX_PORT=8088
COST_API_PREFIX=/api/cost

# Если 1 — Nuxt запускается в режиме "только этот раздел":
#   - skip auth-гейта,
#   - в сайдбаре только пункт «Себестоимость»,
#   - $fetch ходит через nginx-cost (на порту COST_NGINX_PORT).
NUXT_PUBLIC_COST_ONLY=1

# Если 1 — backend отдаёт мок-данные вместо MSSQL/OLAP.
# Нужно, когда у разработчика нет VPN до 10.10.6.107/15: фильтры,
# агрегаты, детали, уровни цен берутся из python/cost/app/mocks.py.
# save-changes/save-batch в моке пишут только в локальный postgres-cost.
COST_MOCK=1

# Если 1 — при утверждении цен НЕ писать в FinSandBox.CostHistory_Changes.
# Нужен для тестов вызова SQL-процедуры на тестовом контуре (srv-test02 /
# test_Gpartner): процедура и локальный аудит отрабатывают как обычно, а боевой
# приёмник изменений остаётся нетронутым. Пусто/не задан — запись идёт обычным
# порядком. В проде ОБЯЗАН быть пустым, иначе утверждённые цены не доедут в DWH.
COST_SKIP_DWH_WRITE=

# Сколько секунд ждать свободное соединение в пуле postgres-cost, прежде чем
# ответить 503 «сервис занят». Пул небольшой (max_size=8), а тяжёлые выборки
# держат соединения долго: без ограничения лёгкая операция (сохранение набора
# цен, согласование) вставала в очередь и висела, пока её не обрывал nginx, —
# в интерфейсе это выглядело как «кнопка не нажимается». Пусто/не задан — 15 с.
# Ставить меньше 5 не стоит: короткие всплески нагрузки станут ошибками.
COST_POOL_ACQUIRE_TIMEOUT=

# ── БД для SQL-процедуры утверждения цен (proc-db) ────────────────────────────
# Сервер для вызова процедуры [dbo].[create_priceList_inFox] с JSON-полезной
# нагрузкой.  Если PROC_DB_SERVER_IP не задан — fallback на MSSQL_SERVER_IP.
# Если PROC_DB_USER не задан — fallback на MSSQL_USER (аналогично пароль).
# Если сервер всё равно пуст — вызов процедуры пропускается (логируется).
PROC_DB_SERVER_IP=
PROC_DB_DATABASE=Gpartner
PROC_DB_USER=
PROC_DB_PASSWORD=
# Имя процедуры: [dbo].[create_priceList_inFox] (см. call_calc_sign_procedure в db.py)
PROC_DB_PROCEDURE=

# ── Логи в ELK (Logstash) ─────────────────────────────────────────────────────
# Дублирование логов раздела в Logstash по TCP, кодек json_lines (service=finance-cost,
# см. app/logship.py). Базовый канал — stdout (его собирает docker) — остаётся всегда.
# Отправка асинхронная и НИКОГДА не блокирует запрос: недоступный Logstash не
# тормозит API, строки просто отбрасываются (счётчик потерь раз в минуту в логе).
# Имена переменных те же, что в корневом .env основного контура (Go-API + Nuxt),
# но контур «Себестоимость» изолирован — задавать надо и здесь.
# LOGSTASH_HOST пусто → трансляция выключена, только stdout.
# LOGSTASH_PORT пусто при заданном HOST → 5044.
LOGSTASH_HOST=
LOGSTASH_PORT=

# Адрес дашборда Superset, который встраивается под нашим на /cost/commercial —
# ДЛЯ СРАВНЕНИЯ двух реализаций одного макета. Инструмент разработчика, не часть
# продукта: guest-токенов нет, iframe работает лишь потому, что браузер уже
# залогинен в Superset на том же хосте. Прод-схема встраивания (guest token из
# Go-API, RLS из существующего ABAC) описана в docs/bi/superset-prod-plan.md.
#
# Пусто → блок сравнения не показывается вовсе. Не задано → берётся дефолт
# http://localhost:8093/superset/dashboard/cost-commercial/ (см.
# nuxt-layer/nuxt.config.ts). Superset поднимается отдельно: cd swarm && make superset-up
NUXT_PUBLIC_SUPERSET_EMBED_URL=

# То же для дашборда «Маржа выпуска» (/cost/margin): адрес его Superset-версии
# для блока сравнения внизу страницы. Пусто → блока нет. Не задано →
# http://localhost:8093/superset/dashboard/cost-margin/
NUXT_PUBLIC_SUPERSET_MARGIN_EMBED_URL=

# Через сколько минут висящий флаг cost_cache_status.is_refreshing считается
# протухшим и может быть отобран (см. db.acquire_or_reclaim_refresh_lock).
#
# Флаг снимают set_cache_completed / set_cache_error на выходе из обновления;
# если процесс умер на середине (деплой, рестарт, OOM), до них дело не доходит и
# флаг остаётся висеть. Без отбора он навсегда заблокировал бы и кнопку
# «обновить», и трёхчасовой тик воркера — кэш перестал бы обновляться молча.
#
# Порог ОБЯЗАН быть выше реальной длительности полного обновления, иначе живое
# обновление в соседнем контейнере (при деплое с order: start-first) примут за
# мёртвое и запустят второе поверх — а два одновременных обновления дублируют
# строки в cost_data_cache. Замер на ~1 млн строк: 25 минут.
#
# Не задано → 45.
COST_STALE_REFRESH_MINUTES=

# ── Разбор блоков графиков языковой моделью («Разбор ИИ») ───────────────────
#
# Под логическими секциями страниц раздела («Маржа выпуска», «Норматив против
# факта», «Динамика цен») показывается блок с наблюдениями по графикам. Считает
# факты бэкенд (app/insights.py), модель только формулирует текст по готовым
# числам — считать ей запрещено промптом.
#
# Пусто или COST_LLM_ENABLED≠1 → блок не показывается вообще: /insights/status
# отдаёт enabled=false, и фронт кнопку не рисует. Раздел от этого не страдает,
# разбор — надстройка.
#
# ВАЖНО про данные. В модель уходят только АГРЕГАТЫ, уже нарисованные на
# графиках (суммы и проценты по месяцам, бренд-менеджерам, группам Level 01),
# плюс подписи осей. Артикулы, модели и построчная себестоимость не уходят.
# Тем не менее это передача данных о марже во внешний сервис — прежде чем
# включать на проде, согласуйте провайдера.
COST_LLM_ENABLED=

# OpenAI-совместимый эндпоинт /chat/completions (без /chat/completions в конце).
# Не задано → https://opencode.ai/zen/v1
COST_LLM_API_BASE=

COST_LLM_API_KEY=

# Модель должна отдавать валидный JSON по инструкции и понимать русский.
# Не задано → deepseek-v4-flash.
#
# БЕРИТЕ МОДЕЛЬ БЕЗ РЕЖИМА РАЗМЫШЛЕНИЙ. Замер 01.09.2026 на блоке «Маржа
# выпуска» (2 графика, 13 фактов):
#   deepseek-v4-flash   7 с,  0.00045 $  — стабильно
#   glm-5              28–50 с, 0.0078 $ — половина вызовов падает: «думающая»
#                                          модель тратит весь лимит токенов на
#                                          рассуждения и до JSON не доходит
# Ошибка в этом случае в логе выглядит как «модель не уложилась в лимит
# токенов» — это не про длину ответа, а про размышления перед ним.
#
# Осторожно с провайдерами, раздающими разные семейства моделей по разным
# протоколам: у opencode zen Claude живёт на /v1/messages, а GPT на
# /v1/responses — обе группы через /chat/completions отвечают HTTP 500. Здесь
# поддержан только /chat/completions, поэтому годятся модели этой группы
# (deepseek-v4-flash, minimax-m2.5, kimi-k2.5, glm-5).
COST_LLM_MODEL=

# Таймаут одного вызова, секунды. Блок из 5 графиков на deepseek-v4-flash —
# около 7 с; на «думающих» моделях доходит до 50 с. Не задано → 60.
COST_LLM_TIMEOUT=

# Бюджет времени на ОДНО углублённое исследование (`/insights/ask`), секунды.
# Не задано → 35.
#
# ЭТО ПРЕДЕЛ ПРОКСИ, А НЕ ВКУСОВАЯ НАСТРОЙКА. В swarm/config/cost.conf у
# `location /api/cost/` не задан proxy_read_timeout, то есть действует дефолтный
# минутный. Исследование на 84 секунды (замер 02.09.2026) бэкенд досчитал и
# вернул 200, а клиент получил от nginx 504 — снаружи это выглядит как ошибка
# приложения. Бюджет проверяется ПЕРЕД шагом, и к нему добавляется ещё один
# вызов модели (FINAL_CALL_RESERVE_S = 20 с в app/insight_agent.py): 35 + 20
# укладывается в минуту с запасом.
#
# Поднимете proxy_read_timeout для /api/cost/ — можно поднять и это значение;
# агент станет успевать больше шагов на сложных вопросах.
COST_LLM_AGENT_BUDGET=

# Уровень внутренних размышлений модели: none | low | medium | high.
# Пусто → none. Пустая строка в коде означает «параметр не отправлять» —
# задать это можно только правкой COST_LLM_REASONING на любое иное значение.
#
# САМАЯ ВАЖНАЯ НАСТРОЙКА ПРОИЗВОДИТЕЛЬНОСТИ. Замер 02.09.2026 на промпте
# агентского размера (~6,4 тыс. токенов), deepseek-v4-flash:
#
#   без параметра          17–127 с, генерация 1448–9571 токенов, 1 таймаут из 5
#   reasoning_effort=none    2–3 с, генерация 24–28 токенов, сбоев нет
#
# `max_tokens` размышления НЕ ограничивает: при max_tokens=300 провайдер
# возвращал completion под 9,6 тыс. токенов. Именно этим объяснялись ошибки
# «модель недоступна: ReadTimeout» — модель думала дольше таймаута. Канал до
# провайдера при этом идеален: DNS 2 мс, TCP 1 мс, TLS 395 мс, прокси в
# контейнере не задан, то есть ни сеть, ни VPN тут не участвуют.
#
# КАЧЕСТВО ОТ ОТКЛЮЧЕНИЯ НЕ СТРАДАЕТ. Тот же блок «Маржа выпуска» в двух
# режимах: по 5 наблюдений, оба нашли незакрытый сентябрь первым пунктом и
# максимум в июне. С размышлениями модель вдобавок нарушила запрет считать
# самостоятельно (вывела «44,71 пп», которых нет в фактах, — валидатор поймал),
# без них все числа сошлись.
#
# Включаете размышления (low и выше) — ОБЯЗАТЕЛЬНО поднимите COST_LLM_TIMEOUT
# минимум до 180, иначе вернутся обрывы.
COST_LLM_REASONING=

# Разрешить приватные адреса провайдера модели (127.0.0.1, 10.x, docker-сеть).
# Пусто → запрещено.
#
# Поле «адрес провайдера» в админке (/cost/admin/llm) — это URL, по которому
# сервер сам делает запрос: без проверки администратор заставил бы python-cost
# стучаться во внутреннюю сеть (postgres, go-api, OLAP, метаданные облака).
# Поэтому по умолчанию требуется https и ПУБЛИЧНЫЙ адрес, причём проверяется
# каждый IP, в который резолвится хост, — имя вроде internal.example.com может
# указывать на 10.0.0.5.
#
# Ставьте 1 только на dev и только если модель поднята локально (Ollama на
# 127.0.0.1:11434). На проде — оставить пустым.
COST_LLM_ALLOW_PRIVATE=

# Белый список хостов провайдера через запятую, например
# opencode.ai,api.z.ai. Пусто → любой публичный хост.
#
# На проде задавать ОБЯЗАТЕЛЬНО: иначе право cost:llm_admin позволяет отправить
# агрегаты по марже любому внешнему адресу. Проверка идёт по хосту адреса,
# заданного в админке.
COST_LLM_ALLOWED_HOSTS=
