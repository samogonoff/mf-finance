# Пинимся к bookworm: prod.list от Microsoft — для debian/12,
# а python:3.12-slim уже уехал на trixie, где sqv строже к keyring path.
FROM python:3.12-slim-bookworm

WORKDIR /var/www/cost

# Базовые утилиты + ODBC stack для SQL Server (нужен pyodbc → msodbcsql18).
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg2 apt-transport-https \
        unixodbc unixodbc-dev gcc g++ \
        postgresql-client \
 && install -d -m 0755 /usr/share/keyrings \
 && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
 && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list \
        > /etc/apt/sources.list.d/mssql-release.list \
 && apt-get update -qq \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
 && rm -rf /var/lib/apt/lists/*

COPY python/cost/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

EXPOSE 8091

# --reload-dir сужаем до app/, чтобы uvicorn не дёргался на каждое изменение
# в nuxt-layer/ (тот же volume, но обслуживает Nuxt).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8091", "--reload", "--reload-dir", "/var/www/cost/app"]
